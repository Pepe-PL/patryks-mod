  "authors": [
    "Pepe-PL"
  ],
  "contact": {
    "sources": "https://github.com/Pepe-PL/patryks-mod"
  },
  "license": "MIT",
  "icon": "assets/patryks-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.pepe_pl.patryks_mod.Main"
    ],
    "client": [
      "io.github.pepe_pl.patryks_mod.client.PatryksClient"
    ]
  },
  "mixins": [
    "patryks-mod.mixins.json"
  ],
  "depends": {
    "minecraft": "~26.2",
    "fabric-api": "*"
  }
